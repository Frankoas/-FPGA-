/**
 * Auto-generated Testbench: {{ tb_name }}
 * Generated by FPGA Visual Programming Tool
 *
 * DUT: {{ dut_name }}
 * Clock: {{ clock_period_ns }} ns
 * Reset cycles: {{ reset_cycles }}
 * Simulation time: {{ sim_time_ns }} ns
 */

`timescale 1ns / 1ps

module {{ tb_name }};

// Clock and reset
reg clk;
reg rst_n;

// Continuous clock generation
initial begin
    clk = 0;
    forever #{{ clock_period_ns / 2.0 }} clk = ~clk;
end

// Reset sequence
initial begin
    rst_n = 0;
    repeat({{ reset_cycles }}) @(posedge clk);
    rst_n = 1;
end

{% for sig in stimuli_signals %}
// Stimulus signal: {{ sig.name }}
reg{% if sig.width > 1 %} [{{ sig.width - 1 }}:0]{% endif %} {{ sig.name }};
{%- endfor %}

{% for sig in monitored_signals %}
// Monitored signal: {{ sig.name }}
wire{% if sig.width > 1 %} [{{ sig.width - 1 }}:0]{% endif %} {{ sig.name }};
{%- endfor %}

// DUT instantiation
{{ dut_name }} u_dut (
{% for sig in stimuli_signals %}
    .{{ sig.name }}({{ sig.name }}){% if not loop.last or monitored_signals|length > 0 %},{% endif %}

{%- endfor %}
{%- for sig in monitored_signals %}
    .{{ sig.name }}({{ sig.name }}){% if not loop.last %},{% endif %}

{%- endfor %}
);

// Waveform dump
initial begin
    $dumpfile("{{ dump_filename }}");
    $dumpvars(0, {{ tb_name }});
end

// Stimulus section
initial begin
{% for sig in stimuli_signals %}
    {{ sig.name }} = 0;
{%- endfor %}

    // Wait for reset de-assertion
    @(posedge rst_n);
    repeat(2) @(posedge clk);

    // STIMULUS: Add your test patterns here

    // Simulation timeout
    #{{ sim_time_ns }};
    $finish;
end

endmodule
