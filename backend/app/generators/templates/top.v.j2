/**
 * Auto-generated Top Module: {{ top_name }}
 * Generated by FPGA Visual Programming Tool
 */

module {{ top_name }}
{%- if parameters %}
#(
{%- for param in parameters %}
    parameter {{ param.name }} = {{ param.value }}{% if not loop.last %},{% endif %}

{%- endfor %}
)
{%- endif %}
(
{%- for port in top_ports %}
    {{ port.direction.value }}{% if port.width > 1 %} [{{ port.width - 1 }}:0]{% endif %} {{ port.name }}{% if not loop.last %},{% endif %}

{%- endfor %}
);

{% for wire in wires %}
    wire{% if wire.width > 1 %} [{{ wire.width - 1 }}:0]{% endif %} {{ wire.name }};
{%- endfor %}

{% for inst in instantiations %}
    // {{ inst.module_name }} {{ inst.inst_name }}
    {{ inst.module_name }}
    {%- if inst.params|length > 0 %}
    #(
    {%- for param in inst.params %}
        .{{ param.name }}({{ param.value }}){% if not loop.last %},{% endif %}

    {%- endfor %}
    )
    {%- endif %}
    {{ inst.inst_name }} (
    {%- for conn in inst.connections %}
        .{{ conn.port_name }}({{ conn.wire_name or '' }}){% if not loop.last %},{% endif %}

    {%- endfor %}
    );

{% endfor %}
endmodule
